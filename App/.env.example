# Copy to .env — use the same Supabase project as portal (EXPO_PUBLIC_* not VITE_*).
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Web / Vercel deploy only — must match Supabase Redirect URLs (see GOOGLE_AUTH.md).
EXPO_PUBLIC_APP_URL=https://which-game-used-mobile-bgny.vercel.app
EXPO_PUBLIC_PORTAL_URL=https://which-game-used.vercel.app
EXPO_PUBLIC_SUPPORT_EMAIL=support@whichgameused.com

# Supabase Dashboard → Authentication:
# - Email provider: ON
# - Email OTP: ON
# - Google provider: ON (see Web/supabase/docs/GOOGLE_AUTH.md)
# Mobile Google OAuth: Supabase Dashboard → Authentication → Redirect URLs must include:
#   whichgameused://auth/callback
# Expo Go only: also add exp://** (or the URL logged at sign-in in Metro).
# Google Console: use Web OAuth client only (not Android) — see Web/supabase/docs/GOOGLE_AUTH.md

# LaunchDarkly + OpenAI keys for "Improve notes" live in Supabase Edge Function secrets
# (writing-improver), NOT in this file. See Web/supabase/functions/writing-improver/DEPLOY.md
