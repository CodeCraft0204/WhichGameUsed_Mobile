# Copy to .env — use the same Supabase project as portal (EXPO_PUBLIC_* not VITE_*).
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
EXPO_PUBLIC_SUPPORT_EMAIL=support@whichgameused.com

# Supabase Dashboard → Authentication:
# - Email provider: ON
# - Email OTP: ON
# Mobile uses signInWithOtp + verifyOtp only (no signUp(password), no resetPasswordForEmail).
