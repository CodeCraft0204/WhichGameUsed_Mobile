{
  "expo": {
    "name": "Which Game Used",
    "slug": "which-game-used",
    "scheme": "whichgameused",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "assets/Splash.png",
      "assets/fonts/**/*",
      "assets/camera/**/*"
    ],
    "plugins": [
      "expo-router",
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "icon": "./assets/Splash.png",
          "color": "#F2EBDC",
          "sounds": []
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/Splash.png",
          "resizeMode": "cover",
          "backgroundColor": "#F2EBDC",
          "enableFullScreenImage_legacy": true,
          "android": {
            "resizeMode": "cover"
          },
          "ios": {
            "resizeMode": "cover",
            "enableFullScreenImage_legacy": true
          }
        }
      ]
    ],
    "splash": {
      "image": "./assets/Splash.png",
      "resizeMode": "cover",
      "backgroundColor": "#F2EBDC"
    },
    "experiments": {
      "typedRoutes": true
    },
    "ios": {
      "bundleIdentifier": "com.whichgameused.mobile",
      "associatedDomains": [
        "applinks:which-game-used.vercel.app"
      ]
    },
    "android": {
      "package": "com.whichgameused.mobile",
      "softwareKeyboardLayoutMode": "resize",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "which-game-used.vercel.app",
              "pathPrefix": "/v"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "a49775a4-fd5d-439a-9e7f-66efbff150e9"
      }
    }
  }
}
